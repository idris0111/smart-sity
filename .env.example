# Optional HTTP AI gateway. These variables are read by the backend only.
# Compose reads .env; run_backend.py also loads the local .env file.
SMART_CITY_AI_URL=
SMART_CITY_AI_KEY=
DJANGO_SECRET_KEY=replace-with-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
POSTGRES_DB=smart_city
POSTGRES_USER=smart_city
POSTGRES_PASSWORD=replace-with-random-password
# Native Django uses the dedicated Compose PostgreSQL port.
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
DEMO_SIMULATION=1
WEBSOCKET_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080
